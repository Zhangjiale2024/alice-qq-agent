# ===== 爱丽丝 QQ 伙伴 Agent 配置 =====
# 复制为 .env 后按需修改。环境变量优先级最高，其次 .env，最后 config.json。

# ---- 角色与关系 ----
AGENT_NAME=爱丽丝 QQ 伙伴
PRIMARY_TYPE=角色陪伴型 Agent
CHARACTER=爱丽丝
RELATIONSHIP=朋友或队友
ROMANCE_ALLOWED=false
DEFAULT_MODE=alice
ASSISTANT_MODE_ENABLED=true
WEB_SEARCH_IN_ALICE_MODE=true

# ---- 模式切换指令 ----
COMMAND_PREFIX=/

# ---- 模型 ----
# provider=mock 时完全离线，用规则模板演示；provider=openai 时走 OpenAI 兼容接口
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=500
LLM_CONTEXT_MESSAGES=10

# ---- 私聊 ----
PRIVATE_CHAT_ENABLED=true
PRIVATE_RATE_LIMIT_PER_MINUTE=6
PRIVATE_MAX_REPLY_CHARS=1200

# ---- 群聊 ----
GROUP_CHAT_ENABLED=true
GROUP_TRIGGER=mention,keyword,command,relevant_topic
GROUP_ACCESS=approved_groups
GROUP_RATE_LIMIT_PER_MINUTE=3
GROUP_RATE_LIMIT_PER_USER=2
GROUP_MAX_REPLY_CHARS=300
GROUP_REPLY_PROBABILITY=1.0
# 只放「确实指向爱丽丝/本作」的词。像「老师」「游戏」「ba」这类日常高频词不能放，
# 否则群里几乎每句话都会被判成相关，表现为「发什么都回复」。
GROUP_KEYWORDS=爱丽丝,アリス,蔚蓝档案,碧蓝档案,blue archive,游戏开发部,千年科学学园,无名众神
# 话题延续是否要求「同一个人接着说」；true 更克制，false 更热情但容易刷屏
GROUP_RELEVANT_TOPIC_SAME_USER=true

# ---- 排障 ----
# 打印每条消息的原文、引擎决策与最终回复；稳定后建议改为 0
ALICE_DEBUG=0

# ---- 主动关心（低频，默认私聊）----
PROACTIVE_ENABLED=true
PROACTIVE_PRIVATE=true
PROACTIVE_GROUP=false
PROACTIVE_FREQUENCY=low
PROACTIVE_MIN_IDLE_MINUTES=360
PROACTIVE_MAX_PER_USER_PER_DAY=1
PROACTIVE_QUIET_HOURS=23,0,1,2,3,4,5,6,7

# ---- 记忆 ----
MEMORY_ENABLED=true
MEMORY_SCOPE=per_user
MEMORY_SENSITIVE_DATA=false
MEMORY_PER_USER_LIMIT=80
CONVERSATION_RETENTION=200

# ---- 额度与频率 ----
QUOTA_ENABLED=true
QUOTA_DAILY_PRIVATE=200
QUOTA_DAILY_GROUP=500
QUOTA_DAILY_GLOBAL=5000
RATE_LIMIT_ENABLED=true

# ---- 媒体能力 ----
EMOJI_ENABLED=true
IMAGE_ENABLED=true
VOICE_ENABLED=1
IMAGE_SOURCE=qq_emoji_first,ai_when_necessary

# ---- 权限 ----
# 机器人所有者 QQ 号，逗号分隔：只有他们能改资料/授权群
# 这里**故意**用示例号。真实的 QQ 号不要写进这个文件——
# 它会随仓库一起公开（scripts\隐私扫描.py 会检查这一点）。
OWNER_IDS=10001

# ---- 群管理 ----
GROUP_MANAGEMENT_ENABLED=true
HIGH_IMPACT_ACTION_CONFIRMATION=true

# ---- V2 联网检索 ----
# 零配置可用：默认走 DuckDuckGo，无需 API Key。
# 有条件建议自建 SearXNG（更稳定、可指定引擎）：
#   SEARCH_PROVIDER=searxng
#   SEARXNG_URL=http://127.0.0.1:8888
SEARCH_ENABLED=true
# 检索源链：按顺序尝试，用第一个相关度达标的结果。
#   bilibili = 【链首】B 站搜索（视频+专栏）。中文游戏/动漫信息最全、
#              pubdate 精确到天，且免费（不消耗博查额度）。
#              需要先访问首页取 cookie，否则接口返回 412 request was banned。
#   bocha    = 官方 API（需 key，按量计费）。覆盖 B 站薄弱的领域
#              （新闻/事实/价格），并作为兜底。
#   so360    = 抓取，命中率好但会被风控
#   bing     = 最后后备，会把系列名拆词（蔚蓝档案 -> Celeste）
SEARCH_PROVIDER=chain
SEARCH_CHAIN=bilibili,bocha,so360,bing
# 百度尝试失败的成本上限（秒）；失败结果会缓存 300s，不会反复付这个代价
SEARCH_TIMEOUT=8
# 实测结论（2026-10）：
#   so360  = 默认，命中率最好，能正确理解"蔚蓝档案"这类系列名
#   bing   = cn.bing.com 可用，但会把系列名拆词匹配（如蔚蓝档案 -> Celeste）
#   duckduckgo = 已被反爬拦截（HTTP 202），不可用
#   searxng = 自建最稳，需配 SEARXNG_URL
# 换用会拆词的检索源时打开消歧（把"蔚蓝档案"补成"蔚蓝档案 手游"）
SEARCH_DISAMBIGUATE=false
SEARCH_AUTO=true
SEARCH_MAX_RESULTS=4
SEARCH_FETCH_PAGES=2
SEARCH_CACHE_TTL=600

# ---- V2 知识库 ----
# 注入提示词的知识总量上限，超出时按优先级丢弃低优先级文件
KNOWLEDGE_MAX_CHARS=12000
KNOWLEDGE_MAX_FILE_CHARS=6000
# 所有者上传资料的优先级前缀（数字越小越优先）
KNOWLEDGE_UPLOAD_PREFIX=90
KNOWLEDGE_UPLOAD_ENABLED=true

# ---- 博查 AI 搜索（推荐，官方接口）----
# 申请：https://open.bochaai.com  （有免费额度）
# 配上 key 后会自动成为检索链的第一位，摘要完整且带发布时间。
BOCHA_API_KEY=
BOCHA_SUMMARY=true

# ---- 学术文献检索（CrossRef / Semantic Scholar / arXiv）----
# 实测定位：
#   arxiv    = 免费稳定，摘要完整 -> 默认首选
#   crossref = 元数据权威，但基本没有摘要；带 DOI 的查询会走它的精确接口
#   s2       = 摘要最好，但**无 key 时几乎必然 429**，默认不启用
ACADEMIC_ENABLED=true
ACADEMIC_ARXIV=true
ACADEMIC_CROSSREF=true
ACADEMIC_S2=true
# 有 Semantic Scholar 的 key 时填这里（免费申请），它会成为首选
SEMANTIC_SCHOLAR_API_KEY=
# 没配 key 时是否仍尝试 S2（会大概率被限流）
ACADEMIC_S2_WITHOUT_KEY=false
ACADEMIC_TIMEOUT=20
ACADEMIC_CACHE_TTL=1800

# ---- 百度（可选，实测网页抓取被安全验证拦截）----
# 网页抓取放行率 0/6（带 cookie 会话也一样）。要稳定使用需要官方 API。
BAIDU_API_KEY=

# ---- V4 多媒体 ----
# 素材库：QQ 表情包与图片。用 /素材上传 <标签>|<说明> 再发一张图即可入库。
MEDIA_ENABLED=1
MEDIA_PATH=media
# 表情包默认低频（命中标签后按概率发送），避免刷屏
STICKER_ENABLED=1
STICKER_PROBABILITY=0.35
STICKER_MIN_INTERVAL=180
# AI 图片生成：按张计费，默认关闭
IMAGE_GEN_ENABLED=0
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=dall-e-3
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_DAILY_CALLS=10
# 语音合成。provider：baidu（免费无 Key）/ google（免费无 Key）/ openai_compatible（需 Key）
# baidu 与 google 无需注册，所以默认开启；只在用户明确要求语音时才合成。
TTS_ENABLED=1
TTS_PROVIDER=baidu
TTS_LANGUAGE=zh
TTS_SPEED=5
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=mp3
TTS_MAX_CHARS=120
TTS_DAILY_CALLS=30
# 群聊主动话题：默认关闭，且需要群主用 /群设置 主动参与 开 显式开启
PROACTIVE_GROUP_MIN_IDLE_MINUTES=240
PROACTIVE_GROUP_MAX_PER_DAY=1

# ---- 语音识别（音频转文字）----
# 两条路，优先用免费的：
#   1) B 站自带 AI 字幕：配好 BILIBILI_SESSDATA 即可，无需本段配置。
#   2) 自有 ASR：B 站没给字幕时兜底。走 OpenAI 兼容的 /audio/transcriptions。
#
# 默认关闭：按时长计费（一个 20 分钟视频约 $0.12），公开服务里必须显式启用。
# 启用后有三重上限，避免被刷成账单事故：
ASR_ENABLED=0
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_MAX_BYTES=8388608
ASR_MAX_SECONDS=300
ASR_DAILY_CALLS=20

# ---- B 站：视频内信息与评论 ----
# SESSDATA = 你自己 B 站账号的登录 Cookie 值（浏览器 F12 → Application → Cookies → bilibili.com → SESSDATA）
# 匿名状态下实测：评论只有 3 条（但是最高赞的几条）、字幕完全不返回。
# 配置后：评论可翻页取更多，且能读到多数视频的 AI/CC 字幕。
# 留空即匿名运行；填错会在启动横幅里提示"无效"，不会静默退化。
BILIBILI_SESSDATA=
# 对前几个视频做富化（简介/字幕/评论）。每个视频额外 3 次请求，设 0 可关闭。
BILIBILI_ENRICH_TOP=2
BILIBILI_COMMENTS=8
BILIBILI_SUBTITLE_CHARS=1200
BILIBILI_COMMENTS_CHARS=600

# ---- V3 公开运营 ----
# 高成本能力各自独立额度（0 表示不限）。群额度与个人额度分别判断。
QUOTA_SEARCH_PRIVATE=60
QUOTA_SEARCH_GROUP=120
QUOTA_SEARCH_GLOBAL=1000
QUOTA_IMAGE=20
QUOTA_VOICE=20

# ---- 存储 ----
DATA_DIR=data
DB_PATH=data/alice.db
GROUP_CONFIG_PATH=data/groups.json

# ---- 克隆音色 / 本地混合音色（可选，自己玩，不公开）----
# 想启用：装好 GPT-SoVITS、启动 api_v2，然后把 TTS_PROVIDER 改成 gptsovits。
# 默认保持 baidu 是为了"服务没起来时也有声音"。
# 详细步骤见 docs/本地部署_混合音色实操.md
#
# **这一段是全文件唯一出现这些键的地方。**
# 曾经这里有两段重复的 TTS 配置，且值互相冲突——
# `TTS_VC_BLEND` 前一段给了 `alice_ja:0.7,alice_zh:0.3`、
# 后一段给了空值，而 **空值会静默覆盖前面的值**，导致混合音色怎么调都不生效。
# scripts/env审计.py 会检查重复键；改动这里之后请跑一次确认。
TTS_CLONE_URL=http://127.0.0.1:9880
# 参考音频是"服务端可见"的路径；主参考建议用中配（保证中文口音），
# 日配放第二个做音色融合。两个参考一起用即相当于音色混合。
TTS_CLONE_REF_AUDIO=
TTS_CLONE_REF_AUDIO_2=
TTS_CLONE_PROMPT_TEXT=
# 情感参考：格式 名称=路径|该音频里逐字说的话
TTS_EMOTION_REFS=
# 克隆服务不可用时自动退回免费 TTS（强烈建议保留）
TTS_FALLBACK=baidu
# 音色转换（可选，推荐）：中文 TTS 负责发音，转换模型负责音色
# 混合两个 CV 音色就体现在 TTS_VC_BLEND 的权重上
TTS_VC_URL=
TTS_VC_MODEL=
# 混合权重：日配 0.7 + 中配 0.3（发音由中文 TTS 保证，故不会有日式口音）
# 要精确控制这个比例需要 RVC 模型融合（见文档路线 2），否则留空
TTS_VC_BLEND=alice_ja:0.7,alice_zh:0.3
TTS_VC_PITCH=0

# 情感：{情感名: 情感参考音频路径}，供 GPT-SoVITS 换语气
# 例：happy=/voices/happy.wav,sad=/voices/sad.wav
# 注意：百度/Google 免费端点没有情感参数，配了也不会生效（会在启动横幅如实标注）
TTS_EMOTION_ENABLED=1
TTS_EMOTION_ALPHA=0.7

