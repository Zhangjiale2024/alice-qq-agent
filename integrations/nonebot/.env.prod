# NoneBot2 运行配置，会被 .env 覆盖。
# 这里只放"进程级"参数；角色与模型配置在项目根目录的 .env 里。
HOST=127.0.0.1
PORT=8095

# 日志级别：DEBUG 可以看到每条消息的收发细节，排障时很有用
LOG_LEVEL=DEBUG

# 关闭 NoneBot 自带的命令前缀处理，避免和 /爱丽丝 这类指令冲突
COMMAND_START=["/"]
COMMAND_SEP=["."]

# 反向 WebSocket 鉴权 token：留空表示不校验。
# 若填写，NapCat 侧必须配置同一个 token。
ONEBOT_ACCESS_TOKEN=
